Name:           lime-apps
Version:        0.1.0
Release:        1%{?dist}
Summary:        Lightweight native desktop applications for LimeOS
License:        MIT
URL:            https://github.com/shidikusik/lime-apps
Source0:        %{url}/releases/download/v%{version}/%{name}-%{version}.tar.gz
BuildRequires:  gcc
BuildRequires:  make
BuildRequires:  pkgconf-pkg-config
BuildRequires:  gtk3-devel
# Runtime shared-library requirements are generated by RPM.

%description
Five small C and GTK3 applications: LimeCalc, LimeNotes, LimeTasks,
LimeView and LimeClock. No background service or web runtime.

%prep
%autosetup

%build
%set_build_flags
%make_build CFLAGS="%{build_cflags}" LDFLAGS="%{build_ldflags}"

%check
%make_build test CFLAGS="%{build_cflags}" LDFLAGS="%{build_ldflags}"

%install
%make_install PREFIX=%{_prefix}

%files
%license LICENSE
%{_bindir}/lime-calc
%{_bindir}/lime-notes
%{_bindir}/lime-tasks
%{_bindir}/lime-view
%{_bindir}/lime-clock
%{_datadir}/applications/lime-*.desktop
%{_datadir}/icons/hicolor/scalable/apps/lime*.svg

%changelog
* Wed Oct 14 2026 shidikusik <200198680+shidikusik@users.noreply.github.com> - 0.1.0-1
- Initial five-app release.
